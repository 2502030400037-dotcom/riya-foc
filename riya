<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Modal</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
    }

    /* Open Button */
    .ai-btn {
      margin: 50px;
      padding: 12px 20px;
      border: none;
      border-radius: 8px;
      background: #111;
      color: white;
      cursor: pointer;
      font-size: 15px;
    }

    /* Overlay */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .modal.active {
      display: flex;
    }

    /* Modal Box */
    .modal-box {
      width: 90%;
      max-width: 500px;
      background: white;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-header h2 {
      margin: 0;
    }

    .close {
      border: none;
      background: transparent;
      font-size: 24px;
      cursor: pointer;
    }

    textarea {
      width: 100%;
      height: 100px;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 10px;
      resize: none;
      font-size: 14px;
    }

    .ask-btn {
      width: 100%;
      margin-top: 12px;
      padding: 12px;
      border: none;
      border-radius: 10px;
      background: #111;
      color: white;
      cursor: pointer;
    }

    .response {
      margin-top: 16px;
      padding: 14px;
      background: #f5f5f5;
      border-radius: 10px;
      min-height: 50px;
      color: #333;
    }
  </style>
</head>

<body>

  <button class="ai-btn" onclick="openModal()">
    ✨ Ask AI
  </button>

  <div class="modal" id="aiModal">
    <div class="modal-box">

      <div class="modal-header">
        <h2>✨ AI Assistant</h2>
        <button class="close" onclick="closeModal()">×</button>
      </div>

      <textarea
        id="prompt"
        placeholder="Ask me anything..."
      ></textarea>

      <button class="ask-btn" onclick="askAI()">
        Ask AI
      </button>

      <div class="response" id="response">
        AI response will appear here...
      </div>

    </div>
  </div>

  <script>
    function openModal() {
      document.getElementById("aiModal").classList.add("active");
    }

    function closeModal() {
      document.getElementById("aiModal").classList.remove("active");
    }

    function askAI() {
      const prompt = document.getElementById("prompt").value;
      const response = document.getElementById("response");

      if (!prompt.trim()) {
        response.textContent = "Please enter a question.";
        return;
      }

      // Demo response
      response.textContent = "Thinking...";

      setTimeout(() => {
        response.textContent =
          "This is a demo AI response. Connect your AI API here to get real responses.";
      }, 800);
    }

    // Close when clicking outside the modal
    document.getElementById("aiModal").addEventListener("click", function(e) {
      if (e.target === this) {
        closeModal();
      }
    });
  </script>

</body>
</html>
